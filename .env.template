# Warehouse automated test configuration. Copy to a protected local/CI secret source;
# never commit real credentials.
TEST_ENVIRONMENT=local
TEST_BASE_URL=http://127.0.0.1:6065
TEST_TIMEOUT=600

# WebDAV account username/password Basic Auth smoke case.
WAREHOUSE_TEST_WEBDAV_USERNAME=
WAREHOUSE_TEST_WEBDAV_PASSWORD=
WAREHOUSE_TEST_WEBDAV_ROOT_PATH=/personal
WAREHOUSE_TEST_WEBDAV_PREFIX=/dav

# WebDAV directory access key smoke case. Use the WebDAV ak_*/sk_* pair,
# not the S3 access key/secret. The tested path must be covered by a binding.
WAREHOUSE_TEST_WEBDAV_ACCESS_KEY=
WAREHOUSE_TEST_WEBDAV_SECRET_KEY=
WAREHOUSE_TEST_WEBDAV_ACCESS_KEY_ROOT_PATH=/personal

# Optional read-only S3 ListBuckets smoke case.
WAREHOUSE_TEST_S3_ACCESS_KEY=
WAREHOUSE_TEST_S3_SECRET_KEY=
WAREHOUSE_TEST_S3_BASE_URL=http://127.0.0.1:6066
WAREHOUSE_TEST_S3_REGION=us-east-1
